# Copia este archivo a .env.local y completa los valores reales.

# Cadena aleatoria de al menos 32 caracteres usada para cifrar la cookie de
# sesión (iron-session). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_PASSWORD=

# Credenciales del corredor (único usuario admin del panel).
ADMIN_EMAIL=corredor@tranhaus.cl
ADMIN_NAME="Nombre del corredor"

# Hash de la contraseña, formato "salt:hash". Generarlo con:
#   npm run hash-password -- "tu-contraseña"
ADMIN_PASSWORD_HASH=

# Opcional: dónde vive el JSON mock (por defecto .data/db.json en el repo).
# TRANHAUS_DATA_DIR=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
