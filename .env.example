# Copia este archivo a .env.local y completa los valores reales.

# Cadena aleatoria de al menos 32 caracteres usada para cifrar la cookie de
# sesión (iron-session). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_PASSWORD=

# Connection string de Postgres (Neon). Cópiala desde el dashboard del
# proyecto en neon.tech — formato: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Token de Vercel Blob (subida de imágenes). Créalo en el dashboard de Vercel:
# Storage → Create Database → Blob → copia el "BLOB_READ_WRITE_TOKEN".
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Las credenciales del admin del panel viven en la base de datos, no en env
# vars. Para crear o resetear la cuenta admin corre:
#   npm run create-admin -- correo@ejemplo.cl "Nombre" "contraseña"
